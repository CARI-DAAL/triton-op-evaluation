# Environment for bridge.py (copy to bridge.env and fill in real secrets).
# The bridge is stateless besides the in-memory eval budget; secrets live only
# in this file (chmod 600) or in the process environment.

# Upstream evaluation service (evaluation API v2.1, plain HTTP).
BRIDGE_UPSTREAM=http://192.169.0.227:11907

# Bearer token the in-sandbox kernel_eval CLI presents (EVALUATION_TOKEN).
BRIDGE_TOKEN=<bridge-token>

# Bearer token for upstream trial submissions.
BRIDGE_UPSTREAM_TOKEN=<upstream-token>

# Task catalog: maps task_id -> op_name + reference path.
BRIDGE_TASKS=/home/e84381970/open-evo-bridge/tasks.json

# Listeners.
BRIDGE_INTERACTION_PORT=11908
BRIDGE_TLS_PORT=11909
BRIDGE_TLS_CERT=/home/e84381970/open-evo-bridge/server.pem
BRIDGE_TLS_KEY=/home/e84381970/open-evo-bridge/server-key.pem

# Wall-clock cap per tool call, seconds.
BRIDGE_MAX_WAIT_SECONDS=840

# Per-trial interactive eval budget (legacy max_eval_turns; negative disables).
BRIDGE_MAX_EVAL_TURNS=18

# Performance params submitted with --action benchmark (JSON).
BRIDGE_PERF_PARAMS={"warmup": 5, "repeats": 20, "method": "profiler"}
