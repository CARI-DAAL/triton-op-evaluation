# Deploy-time settings for docker compose (pass with: --env-file docker.env)
# Copy to docker.env and adjust. These parameterize the build + run; they are NOT the
# service's runtime env (docker-compose.yml injects that directly).
#
# Startup goes through scripts/compose.sh, which runs scripts/deployment_preflight.py
# first and refuses to start when any check fails. The gateway bind host is exported
# by the wrapper — do not hand-set TRITON_EVAL_API_HOST.

# --- NPU chip(s) ---
# Physical card id(s), comma-separated. MUST match the /dev/davinciN device list in
# docker-compose.yml (edit both together — the env list and the mounted devices).
# Example shows 8 cards (8–15); use one id for a single-chip deployment.
TRITON_EVAL_CARDS=8,9,10,11,12,13,14,15

# --- Redis (host, via --network host) ---
# Point at the host Redis. Use a dedicated DB to stay clear of other services.
# Redis itself is Compose-managed with AOF appendfsync always + the named
# triton-eval-redis-v2 volume; never run `compose down -v` on this deployment.
TRITON_EVAL_REDIS_URL=redis://127.0.0.1:6379/7

# --- API ---
# Fixed production port; the API binds the preflight-validated bridge gateway of
# Docker network kernel-agent-sandbox-net (exported by scripts/compose.sh).
TRITON_EVAL_API_PORT=11907
# Consumers reach the service through this exact URL (also checked by preflight).
EVALUATION_URL=http://172.18.0.1:11907
# The gateway must bypass any HTTP proxy as a complete comma entry.
PROXY_HOST=172.18.0.1
NO_PROXY=localhost,172.18.0.1,127.0.0.1

# --- Immutable images (REQUIRED, no tag-only defaults) ---
# The eval service image must be a full sha256 digest reference; preflight inspects
# the local image and rejects absent or mismatched RepoDigests.
TRITON_EVAL_IMAGE=registry.example.com/triton-eval@sha256:<64-lowercase-hex>
# Sole evaluator_build recorded in Provenance; must equal TRITON_EVAL_IMAGE
# (or an explicitly reviewed git:<40-lowercase-hex> dev build).
TRITON_EVAL_EVALUATOR_BUILD=registry.example.com/triton-eval@sha256:<64-lowercase-hex>

# --- Caller capabilities + trusted release catalog (mounted read-only) ---
# Capability secret file: mode must not be broader than 0600.
TRITON_EVAL_CAPABILITY_FILE=/srv/triton-eval-secrets/triton-eval.json
# Release catalog root (manifest + references); read-only mount, no dynamic API.
TRITON_EVAL_CATALOG_ROOT=/srv/triton-eval-release
TRITON_EVAL_CATALOG_MANIFEST=/srv/triton-eval-release/catalog.json

# --- Python interpreter (host env bind-mount mode) ---
# docker-compose.yml already defaults PYTHON_BIN to a host conda env. Override here only if
# your env lives at a different path. Must be a conda env with torch/torch_npu/triton.
# PYTHON_BIN=/home/n84449292/miniconda3/envs/kernelgym/bin/python3

# --- Image / ML stack (defaults = validated baseline; override only if your env differs) ---
BASE_IMAGE=quay.io/ascend/vllm-ascend:v0.22.1rc1-a3
TORCH_SPEC=torch==2.9.0
TORCH_NPU_SPEC=torch_npu==2.9.0
TRITON_SPEC=triton==3.5.0
TRITON_ASCEND_SPEC=triton-ascend==3.2.0
# Set if torch_npu / triton-ascend are not on PyPI (e.g. the Ascend wheel index).
PIP_EXTRA_INDEX_URL=
