# Deploy-time settings for docker compose (pass with: --env-file docker.env).
# Copy to docker.env and adjust. Startup goes through scripts/compose.sh +
# scripts/deployment_preflight.py.
# For the plain Docker path use .env (see .env.example) + scripts/docker_run.sh.

# --- NPU chip(s) ---
# Physical card id(s), comma-separated. MUST match the /dev/davinciN device list in
# docker-compose.yml (edit both together — the env list and the mounted devices).
TRITON_EVAL_CARDS=8,9,10,11,12,13,14,15

# --- Redis (host, via --network host) ---
TRITON_EVAL_REDIS_URL=redis://127.0.0.1:6379/7

# --- API ---
TRITON_EVAL_API_PORT=11907
EVALUATION_URL=http://172.18.0.1:11907
PROXY_HOST=172.18.0.1
NO_PROXY=localhost,172.18.0.1,127.0.0.1

# --- Immutable images (REQUIRED, no tag-only defaults) ---
TRITON_EVAL_IMAGE=registry.example.com/triton-eval@sha256:<64-lowercase-hex>
TRITON_EVAL_EVALUATOR_BUILD=registry.example.com/triton-eval@sha256:<64-lowercase-hex>

# --- Engine whole-run budgets ---
TRITON_EVAL_VERIFY_BUDGET_CAP_SECONDS=1500
TRITON_EVAL_BENCHMARK_TIMEOUT_SECONDS=600

# --- Caller capabilities + trusted release catalog (mounted read-only) ---
TRITON_EVAL_CAPABILITY_FILE=/srv/triton-eval-secrets/triton-eval.json
TRITON_EVAL_CATALOG_ROOT=/srv/triton-eval-release
TRITON_EVAL_CATALOG_MANIFEST=/srv/triton-eval-release/catalog.json

# --- Python interpreter (host env bind-mount mode) ---
# PYTHON_BIN=/home/n84449292/miniconda3/envs/kernelgym/bin/python3

# --- Build args for compose rebuilds (defaults live in the Dockerfile ARGs;
#     versions themselves live in pyproject [npu]) ---
# BASE_IMAGE=python:3.11
# Set when torch_npu / triton-ascend are not reachable from PyPI.
PIP_EXTRA_INDEX_URL=

# Rollout traffic class: server-declared RL callers (JSON list of caller_id).
# TRITON_EVAL_ROLLOUT_CALLER_IDS='["rl-runner-1"]'
# TRITON_EVAL_ROLLOUT_RATE_LIMIT_PER_MINUTE=600
# TRITON_EVAL_ROLLOUT_MAX_INFLIGHT=256
# Note: rollout callers still share the per-session inflight cap
# (TRITON_EVAL_SESSION_MAX_INFLIGHT, default 2) — give each concurrent
# rollout step its own X-Session-ID or submissions hit 413 limit_exceeded.

# Card health loop (spec §10): poison quarantine threshold + claim affinity.
# TRITON_EVAL_POISON_DEATH_THRESHOLD=2
# TRITON_EVAL_CARD_AFFINITY_AVOIDANCE=true

# Canary + recovery ladder (spec §10). Reset command is site-specific; "{card}"
# is substituted. Max step: 1=cleanup, 2=+device reset, 3=+process restart.
# TRITON_EVAL_CANARY_BUDGET_SECONDS=120
# TRITON_EVAL_CANARY_INTERVAL_SECONDS=60
# TRITON_EVAL_CARD_RESET_COMMAND=
# TRITON_EVAL_CARD_RECOVERY_MAX_STEP=2
# TRITON_EVAL_CARD_RECOVERY_RETRY_SECONDS=300
# TRITON_EVAL_CARD_CANARY_ON_STARTUP=true
