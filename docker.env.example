# Deploy-time settings for docker compose (pass with: --env-file docker.env)
# Copy to docker.env and fill in from your NPU host. These are NOT the service's
# runtime env (that is injected by docker-compose.yml directly).

# --- ML stack: MUST match the versions in your working host env ---
# On the host, in the env you use to run these kernels, run:
#   python3 -c "import torch, torch_npu; print(torch.__version__, torch_npu.__version__)"
#   pip show triton-ascend | grep -E '^(Name|Version)'   # or however it's installed
# then set the exact pins below.
TORCH_SPEC=torch==2.1.0
TORCH_NPU_SPEC=torch_npu==2.1.0
TRITON_ASCEND_SPEC=triton-ascend
PANDAS_SPEC=pandas
# If torch_npu / triton-ascend are not on PyPI, point at the index that has them
# (e.g. the Ascend wheel index). Leave empty to use PyPI only.
PIP_EXTRA_INDEX_URL=

# --- Host CANN + cards ---
# Ascend root that contains ascend-toolkit/ and driver/ (you said you'd provide this).
CANN_PATH=/usr/local/Ascend
# Physical NPU cards to run one worker each; also edit worker.devices in the compose file.
TRITON_EVAL_CARDS=0

# --- API ---
TRITON_EVAL_API_PORT=8000
