# Deploy-time settings for docker compose (pass with: --env-file docker.env)
# Copy to docker.env and adjust. These parameterize the build + run; they are NOT the
# service's runtime env (docker-compose.yml injects that directly).

# --- NPU chip(s) ---
# Physical card id(s). MUST match the /dev/davinciN device(s) in docker-compose.yml.
# Single chip shown; for multiple, list them comma-separated AND add /dev/davinciN lines.
TRITON_EVAL_CARDS=14

# --- Redis (host, via --network host) ---
# Point at the host Redis. Use a dedicated DB to stay clear of other services.
TRITON_EVAL_REDIS_URL=redis://127.0.0.1:6379/0

# --- API ---
TRITON_EVAL_API_PORT=8000

# --- Image / ML stack (defaults = validated baseline; override only if your env differs) ---
BASE_IMAGE=quay.io/ascend/vllm-ascend:v0.22.1rc1-a3
TORCH_SPEC=torch==2.9.0
TORCH_NPU_SPEC=torch_npu==2.9.0
TRITON_SPEC=triton==3.5.0
TRITON_ASCEND_SPEC=triton-ascend==3.2.1
# Set if torch_npu / triton-ascend are not on PyPI (e.g. the Ascend wheel index).
PIP_EXTRA_INDEX_URL=
