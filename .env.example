# triton-evaluation environment — copy to .env and set site-specific values.
# Consumed by scripts/start.sh (host path) and scripts/docker_run.sh (Docker
# path). Docker compose uses docker.env instead (see docker.env.example).

# =============================================================================
#  SERVICE RUNTIME (consumed by triton_evaluation.config.Settings)
# =============================================================================

# Redis: task queue + durable result store. Must be reachable from the host
# (Docker path uses --network host, so 127.0.0.1 works inside the container).
TRITON_EVAL_REDIS_URL=redis://127.0.0.1:6379/0

# API bind address / port. The Docker path binds 0.0.0.0 (host network); the
# host path defaults to 127.0.0.1.
TRITON_EVAL_API_HOST=0.0.0.0
TRITON_EVAL_API_PORT=10907

# NPU cards to run workers on. One worker process per physical card, pinned via
# ASCEND_RT_VISIBLE_DEVICES. Comma-separated ids (no spaces).
TRITON_EVAL_CARDS=0,1,2,3

# MB of device memory each worker allocates at startup and holds for its
# lifetime so `npu-smi info` shows the worker continuously. 0 disables.
TRITON_EVAL_DEVICE_HOLD_MB=64

# Evaluation engine (verify / internal benchmark / profile / validate) lives
# INSIDE the package. Leave unset to use the bundled engine.
# TRITON_EVAL_ENGINE_DIR=/opt/triton-eval-engine

# Task record TTL in seconds (default 86400 = 24h)
TRITON_EVAL_TASK_TTL_SECONDS=86400

# Worker BRPOP block timeout in seconds
TRITON_EVAL_DEQUEUE_BLOCK_SECONDS=5

# Reaper safety margin added on top of each job's own timeout.
TRITON_EVAL_REAPER_GRACE_SECONDS=120

# =============================================================================
#  DOCKER (scripts/docker_run.sh; build steps live in README "Run in Docker")
# =============================================================================

# Host CANN toolkit path (bind-mounted read-only). Must match the host driver.
# Example path — change to your actual CANN installation.
CANN_HOST=/home/canada_group_folder/CANN/9.0.0.0430

# Optional docker build overrides (defaults live in the Dockerfile ARGs):
#   BASE_IMAGE — any aarch64 base with bash + python3.11
#   pass with: docker build --build-arg BASE_IMAGE=... (see README)

# =============================================================================
#  HOST PATH ONLY (scripts/start.sh; the Docker path needs its own CANN wiring)
# =============================================================================

# CANN toolkit env script to source before launch (leave blank to skip).
CANN_SET_ENV_PATH=/usr/local/Ascend/ascend-toolkit/set_env.sh

# Python interpreter for the host launcher. Set when python3 does not have the
# Ascend stack; must point into the env created by `pip install -e ".[npu]"`.
# PYTHON_BIN=/path/to/conda/env/bin/python3

# Where start.sh writes api.log / worker_<card>.log
LOG_DIR=logs

# =============================================================================
#  PROFILING (consumed by ProfileEvaluator / engine/profile.py)
# =============================================================================

# msprof executable. Use an absolute path when CANN's bin directory is not on PATH.
MSPROF_BIN=msprof

# Python used by msprof to execute the generated kernel runner.
# MSPROF_PROFILE_PYTHON=/path/to/npu/env/bin/python

# Maximum seconds for one runner/msprof subprocess.
MSPROF_TIMEOUT_SEC=300
