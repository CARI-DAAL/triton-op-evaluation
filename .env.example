# triton-evaluation environment (copy to .env and set site-specific values)
# Style mirrors kernelgym-npu/.env.example (flat KEY=VALUE, sourced by scripts/start.sh)

# --- Consumed by the service (Settings.from_env) ---

# Redis: task queue + result store
TRITON_EVAL_REDIS_URL=redis://localhost:6379/0

# Absolute path to the triton-op-verifier skill's scripts
# (contains verify.py / benchmark.py / validate_triton_impl.py). Called via subprocess.
TRITON_EVAL_SKILL_SCRIPTS_DIR=/home/yubaifeng/e84381970/projects/cannbot-skills/ops/triton-op-verifier/scripts

# Task record TTL in seconds (default 86400 = 24h)
TRITON_EVAL_TASK_TTL=86400

# Worker BRPOP block timeout in seconds
TRITON_EVAL_DEQUEUE_BLOCK=5

# Reaper safety margin (seconds) added on top of each job's own timeout before it is
# considered worker_lost. Effective deadline = job.timeout + this margin.
TRITON_EVAL_REAPER_GRACE=120

# --- Consumed only by scripts/start.sh ---

# API bind address / port (uvicorn)
TRITON_EVAL_API_HOST=0.0.0.0
TRITON_EVAL_API_PORT=8000

# NPU cards to run workers on. One worker process per card, each pinned via
# ASCEND_RT_VISIBLE_DEVICES. Comma-separated physical card ids.
TRITON_EVAL_CARDS=0,1,2,3

# CANN toolkit env script to source before launch (leave blank to skip)
CANN_SET_ENV_PATH=/usr/local/Ascend/ascend-toolkit/set_env.sh

# Where start.sh writes api.log / worker_<card>.log
LOG_DIR=logs
