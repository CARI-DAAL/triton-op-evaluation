# triton-evaluation environment (copy to .env and set site-specific values)
# Style mirrors kernelgym-npu/.env.example (flat KEY=VALUE, sourced by scripts/start.sh)

# --- Consumed by the service (Settings.from_env) ---

# Redis: task queue + result store
TRITON_EVAL_REDIS_URL=redis://localhost:6379/0

# Evaluation engine (verify / internal benchmark / profile / validate) lives
# INSIDE the package (triton_evaluation/engine) — the service is self-contained.
# Leave this UNSET to use the bundled engine. Only set it to point at a different
# engine build.
# TRITON_EVAL_ENGINE_DIR=/opt/triton-eval-engine

# Task record TTL in seconds (default 86400 = 24h)
TRITON_EVAL_TASK_TTL_SECONDS=86400

# Worker BRPOP block timeout in seconds
TRITON_EVAL_DEQUEUE_BLOCK_SECONDS=5

# Reaper safety margin (seconds) added on top of each job's own timeout before it is
# considered worker_lost. Effective deadline = job.timeout + this margin.
TRITON_EVAL_REAPER_GRACE_SECONDS=120

# --- Consumed only by scripts/start.sh ---

# API bind address / port (uvicorn)
TRITON_EVAL_API_HOST=0.0.0.0
TRITON_EVAL_API_PORT=10907

# NPU cards to run workers on. One worker process per card, each pinned via
# ASCEND_RT_VISIBLE_DEVICES. Comma-separated physical card ids.
TRITON_EVAL_CARDS=0,1,2,3

# CANN toolkit env script to source before launch (leave blank to skip)
CANN_SET_ENV_PATH=/usr/local/Ascend/ascend-toolkit/set_env.sh

# Python interpreter for the API + workers. The default `python3` usually lacks
# torch/torch_npu/triton — set this to a conda env that has the Ascend stack.
# PYTHON_BIN=/home/n84449292/miniconda3/envs/kernelgym/bin/python3

# Where start.sh writes api.log / worker_<card>.log
LOG_DIR=logs

# --- Consumed by ProfileEvaluator / engine/profile.py ---

# msprof executable. Use an absolute path when CANN's bin directory is not on PATH.
MSPROF_BIN=msprof

# Python used by msprof to execute the generated kernel runner.
# Leave unset to use the worker's sys.executable.
# MSPROF_PROFILE_PYTHON=/path/to/npu/env/bin/python

# Maximum seconds for one runner/msprof subprocess. The total job timeout still wins.
MSPROF_TIMEOUT_SEC=300
