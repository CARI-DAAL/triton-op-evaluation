# Host launcher settings. Compose uses docker/.env.example.
TRITON_EVAL_REDIS_URL=redis://127.0.0.1:6379/7
TRITON_EVAL_REDIS_PREFIX=triton-eval:v2.1
# Bump after changing the hardware/runtime used for Torch baseline timings.
TRITON_EVAL_BASELINE_CACHE_NAMESPACE=torch-baseline-v1
TRITON_EVAL_API_HOST=10.0.0.11
TRITON_EVAL_API_PORT=11907
TRITON_EVAL_CARDS=0,1,2,3
TRITON_EVAL_CPU_WORKERS=1
TRITON_EVAL_DEVICE_HOLD_MB=64
TRITON_EVAL_CAPABILITY_SECRET_PATH=/run/secrets/triton-eval
TRITON_EVAL_EVALUATOR_BUILD=git:<40-lowercase-hex>
# Release identity. release mode verifies the installed sources, dependencies
# and build against this manifest and refuses to start otherwise; generate it
# with scripts/release_manifest.py and bind the same build identity.
TRITON_EVAL_RELEASE_MODE=release
TRITON_EVAL_RELEASE_MANIFEST=/srv/triton-eval/release-manifest.json
TRITON_EVAL_REFERENCE_DEVICE_POLICY=cpu-first
# Optional operator-only observations, retained outside candidate attempts.
# TRITON_EVAL_REFERENCE_DIAGNOSTICS_DIR=/srv/triton-eval/reference-diagnostics
TRITON_EVAL_RETENTION_SECONDS=604800
TRITON_EVAL_MAX_RECOVERY_AGE_SECONDS=86400
TRITON_EVAL_VERIFY_BUDGET_CAP_SECONDS=1500
TRITON_EVAL_BENCHMARK_TIMEOUT_SECONDS=600
# Populate from the deployed toolchain; empty disables verdict reuse.
TRITON_EVAL_CANN_FINGERPRINT=
CANN_SET_ENV_PATH=/usr/local/Ascend/ascend-toolkit/set_env.sh
# PYTHON_BIN=/path/to/venv/bin/python3
LOG_DIR=logs
MSPROF_BIN=msprof
MSPROF_TIMEOUT_SEC=300
MSPROF_DISCOVERY_TIMEOUT_SEC=900
