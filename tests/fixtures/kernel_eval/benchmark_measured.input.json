 "params": {
  "action": "benchmark",
  "kernel_code": "import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _at_b_tile(\n    a_ptr, b_ptr, c_ptr,\n    M, N, K,\n    stride_am, stride_an,\n    stride_bm, stride_bk,\n    stride_cn, stride_ck,\n    BLOCK_M: tl.constexpr,\n    BLOCK_N: tl.constexpr,\n    BLOCK_K: tl.constexpr,\n    EVEN: tl.constexpr,\n):\n    pid_n = tl.program_id(0)\n    pid_k = tl.program_id(1)\n    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\n    offs_k = pid_k * BLOCK_K + tl.arange(0, BLOCK_K)\n    offs_m = tl.arange(0, BLOCK_M)\n    acc = tl.zeros((BLOCK_N, BLOCK_K), dtype=tl.float32)\n    if EVEN:\n        for m0 in range(0, M, BLOCK_M):\n            cur_m = m0 + offs_m\n            a_ptrs = a_ptr + cur_m[:, None] * stride_am + offs_n[None, :] * stride_an\n            b_ptrs = b_ptr + cur_m[:, None] * stride_bm + offs_k[None, :] * stride_bk\n            a = tl.load(a_ptrs)\n            b = tl.load(b_ptrs)\n            acc += tl.dot(tl.trans(a), b)\n        c_ptrs = c_ptr + offs_n[:, None] * stride_cn + offs_k[None, :] * stride_ck\n        tl.store(c_ptrs, acc.to(c_ptr.dtype.element_ty))\n    else:\n        n_mask = offs_n < N\n        k_mask = offs_k < K\n        for m0 in range(0, M, BLOCK_M):\n            cur_m = m0 + offs_m\n            m_mask = cur_m < M\n            a_ptrs = a_ptr + cur_m[:, None] * stride_am + offs_n[None, :] * stride_an\n            b_ptrs = b_ptr + cur_m[:, None] * stride_bm + offs_k[None, :] * stride_bk\n            am = m_mask[:, None] & n_mask[None, :] if 1 else m_mask[None, :] & n_mask[:, None]\n            bm = m_mask[:, None] & k_mask[None, :]\n            a = tl.load(a_ptrs, mask=am, other=0.0)\n            b = tl.load(b_ptrs, mask=bm, other=0.0)\n            acc += tl.dot(tl.trans(a), b)\n        c_ptrs = c_ptr + offs_n[:, None] * stride_cn + offs_k[None, :] * stride_ck\n        tl.store(c_ptrs, acc.to(c_ptr.dtype.element_ty),\n                 mask=n_mask[:, None] & k_mask[None, :])\n\n\ndef _pick_blocks(m, n, k):\n    if m <= 16:\n        bm = 16\n    elif m <= 32:\n        bm = 32\n    elif m <= 64:\n        bm = 64\n    else:\n        bm = 64\n    if n <= 16:\n        bn = 16\n    elif n <= 32:\n        bn = 32\n    elif n <= 64:\n        bn = 64\n    else:\n        bn = 128\n    if k <= 16:\n        bk = 16\n    elif k <= 32:\n        bk = 32\n    elif k <= 64:\n        bk = 64\n    else:\n        bk = 128\n    return bm, bn, bk\n\n\nclass ModelNew(torch.nn.Module):\n    def __init__(self):\n        super(ModelNew, self).__init__()\n\n    def forward(self, A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:\n        m = A.shape[0]\n        n = A.shape[1]\n        k = B.shape[1]\n        bm, bn, bk = _pick_blocks(m, n, k)\n        even = (m % bm == 0) and (n % bn == 0) and (k % bk == 0)\n        out = torch.empty((n, k), dtype=A.dtype, device=A.device)\n        grid = (triton.cdiv(n, bn), triton.cdiv(k, bk))\n        _at_b_tile[grid](\n            A, B, out,\n            m, n, k,\n            A.stride(0), A.stride(1),\n            B.stride(0), B.stride(1),\n            out.stride(0), out.stride(1),\n            BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, EVEN=even,\n        )\n        return out\n",
  "eval_turn": 1,
  "eval_budget": "1/18"
 },
